<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cosx.blog.product.infrastructure.mapper.ProductMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="cn.cosx.blog.product.domain.entity.Product">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
        <result column="lock_version" property="lockVersion"/>
        <result column="name" property="name"/>
        <result column="cover" property="cover"/>
        <result column="category_id" property="categoryId"/>
        <result column="price" property="price"/>
        <result column="total_stock" property="totalStock"/>
        <result column="saleable_stock" property="saleableStock"/>
        <result column="occupied_stock" property="occupiedStock"/>
        <result column="frozen_stock" property="frozenStock"/>
        <result column="detail" property="detail"/>
        <result column="status" property="status"/>
        <result column="sale_time" property="saleTime"/>
        <result column="identifier" property="identifier"/>
        <result column="create_by" property="createBy"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, create_time, update_time, deleted, lock_version, 
        name, cover, category_id, price, total_stock, 
        saleable_stock, occupied_stock, frozen_stock, detail, 
        status, sale_time, identifier, create_by
    </sql>

    <!-- 根据分类ID列表和游标分页查询商品 -->
    <select id="selectByCategoryIdsWithCursor" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM product
        WHERE deleted = 0
        <if test="categoryIds != null and categoryIds.size() > 0">
            AND category_id IN
            <foreach collection="categoryIds" item="categoryId" open="(" separator="," close=")">
                #{categoryId}
            </foreach>
        </if>
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
        <if test="lastId != null">
            AND id &lt; #{lastId}
        </if>
        ORDER BY id DESC
        LIMIT #{pageSize}
    </select>

</mapper>

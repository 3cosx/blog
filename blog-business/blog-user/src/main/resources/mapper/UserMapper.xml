<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.cosx.blog.user.infrastructure.mapper.UserMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="cn.cosx.blog.user.domain.entity.User">
        <id column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
        <result column="lock_version" property="lockVersion"/>
        <result column="nick_name" property="nickName"/>
        <result column="state" property="state"/>
        <result column="telephone" property="telephone"/>
        <result column="last_login_time" property="lastLoginTime"/>
        <result column="profile_photo_url" property="profilePhotoUrl"/>
        <result column="certification" property="certification"/>
        <result column="real_name" property="realName"/>
        <result column="id_card_no" property="idCardNo"/>
        <result column="user_role" property="userRole"/>
        <result column="email" property="email"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, create_time, update_time, deleted, lock_version, 
        nick_name, state, telephone, last_login_time, profile_photo_url, 
        certification, real_name, id_card_no, user_role, email
    </sql>

</mapper>
